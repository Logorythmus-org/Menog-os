{
  "name": "menog-os",
  "private": true,
  "version": "0.0.1",
  "license": "MPL-2.0",
  "type": "module",
  "description": "Menog OS — local-first, observable, zero-trust, Linux-native agentic runtime",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:local": "node scripts/setup-local.mjs",
    "clean": "rimraf --glob node_modules packages/*/node_modules packages/*/dist apps/*/node_modules apps/*/dist tests/*/node_modules"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@webgpu/types": "0.1.74",
    "rimraf": "6.1.3",
    "typescript": "5.7.2",
    "vitest": "2.1.9"
  },    "pnpm": {
      "overrides": {
        "brace-expansion": "5.0.12",
        "source-map-js": "1.2.2"
      }
    }
}
